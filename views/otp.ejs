<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('customer.otp_title', 'Verifikasi OTP') %> | Portal ISP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#030712">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap');

    body {
      background-color: #030712;
      color: #f3f4f6;
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      position: relative;
      overflow-x: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }

    /* ── GLOWING BACKGROUND ORBS ── */
    .glow-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(120px);
      z-index: 0;
      pointer-events: none;
      opacity: 0.35;
      animation: pulseOrb 8s infinite alternate ease-in-out;
    }

    .orb-1 {
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, #6366f1 0%, rgba(99,102,241,0) 70%);
      top: -10%;
      left: -5%;
    }

    .orb-2 {
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, #06b6d4 0%, rgba(6,182,212,0) 70%);
      bottom: -15%;
      right: -10%;
      animation-delay: 2s;
    }

    .orb-3 {
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, #ec4899 0%, rgba(236,72,153,0) 70%);
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.15;
      animation-delay: 4s;
    }

    @keyframes pulseOrb {
      0% { transform: scale(1) translate(0, 0); }
      100% { transform: scale(1.15) translate(20px, -20px); }
    }

    .login-container {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 440px;
      padding: 24px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-card {
      background: rgba(10, 15, 30, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.12);
      overflow: hidden;
      width: 100%;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .login-card:hover {
      box-shadow: 0 35px 70px rgba(0, 0, 0, 0.7), 0 0 30px rgba(99, 102, 241, 0.1);
    }

    .login-header {
      background: linear-gradient(180deg, rgba(99, 102, 241, 0.12) 0%, rgba(59, 130, 246, 0.02) 100%);
      color: #f8fafc;
      padding: 36px 24px 28px;
      text-align: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .logo-container {
      width: 86px;
      height: 86px;
      background: radial-gradient(135deg, rgba(15, 23, 42, 0.8), rgba(30, 41, 59, 0.8));
      border: 2px solid rgba(99, 102, 241, 0.25);
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 0 16px rgba(99, 102, 241, 0.15);
      position: relative;
    }

    .logo-container::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 25px;
      border: 1px dashed rgba(6, 182, 212, 0.3);
      animation: spinBorder 20s linear infinite;
    }

    @keyframes spinBorder {
      to { transform: rotate(360deg); }
    }

    .logo-container img {
      width: 52px;
      height: 52px;
      object-fit: contain;
    }

    .login-header h4 {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      letter-spacing: -0.5px;
      font-size: 20px;
      background: linear-gradient(135deg, #ffffff 40%, #a5b4fc 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 6px;
    }

    .form-container {
      padding: 32px 28px;
    }

    /* ── INPUT FIELDS ── */
    .form-floating {
      margin-bottom: 24px;
      position: relative;
    }

    .form-control {
      background: rgba(5, 10, 20, 0.5) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      color: #f3f4f6 !important;
      border-radius: 14px;
      padding: 16px 20px;
      font-size: 16px;
      font-weight: 500;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .form-control:focus {
      background: rgba(5, 10, 20, 0.75) !important;
      border-color: #06b6d4 !important;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.25), inset 0 1px 2px rgba(0, 0, 0, 0.4) !important;
      color: #fff !important;
    }

    .form-control-otp {
      letter-spacing: 12px;
      font-size: 26px;
      font-weight: 800;
      text-align: center;
      font-family: 'Space Grotesk', sans-serif;
    }

    .form-control-otp::placeholder {
      letter-spacing: 12px;
      color: rgba(156, 163, 175, 0.3);
    }

    .form-floating>label {
      color: #9ca3af;
      padding: 16px 20px;
      font-size: 14px;
      transition: transform .2s ease, color .2s ease;
    }

    .form-floating>.form-control:focus~label,
    .form-floating>.form-control:not(:placeholder-shown)~label {
      color: #06b6d4;
      transform: scale(.85) translateY(-10px) translateX(10px);
    }

    /* ── BUTTON LOGIN ── */
    .btn-login {
      background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%);
      border: none;
      border-radius: 14px;
      padding: 16px;
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-login:hover {
      background: linear-gradient(135deg, #4f46e5 0%, #0891b2 100%);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(99, 102, 241, 0.4), 0 0 15px rgba(6, 182, 212, 0.25);
    }

    .btn-login:active {
      transform: translateY(0);
    }

    /* ── INFO BLOCKS ── */
    .otp-info {
      border: 1px solid rgba(6, 182, 212, 0.15);
      background: rgba(6, 182, 212, 0.05);
      border-radius: 16px;
      padding: 14px 16px;
      color: #e5e7eb;
      font-size: 13px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .otp-info i {
      color: #06b6d4;
      font-size: 18px;
    }

    .alert {
      border-radius: 14px;
      border: 1px solid rgba(239, 68, 68, 0.15) !important;
      background: rgba(239, 68, 68, 0.08) !important;
      color: #fca5a5 !important;
      font-size: 13px;
    }

    .footer-text {
      color: #6b7280;
      font-size: 12px;
      margin-top: 32px;
    }

    @media (max-width: 576px) {
      .login-container {
        padding: 12px;
      }
      .login-card {
        border-radius: 20px;
      }
      .form-container {
        padding: 24px 20px;
      }
    }
  </style>
</head>

<body>
  <!-- Glowing Background Orbs -->
  <div class="glow-orb orb-1"></div>
  <div class="glow-orb orb-2"></div>
  <div class="glow-orb orb-3"></div>

  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="logo-container">
          <img src="/img/logo.png" alt="Logo">
        </div>
        <h4>Verifikasi OTP</h4>
        <p class="mb-0 opacity-75 small">Masukkan kode OTP dari WhatsApp</p>
      </div>
      <div class="form-container">
        <% if (error) { %>
          <div class="alert alert-danger mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
          </div>
        <% } %>

        <div class="otp-info">
          <i class="bi bi-info-circle"></i>
          <div>Kode OTP telah dikirim ke nomor <strong><%= phone %></strong></div>
        </div>

        <form method="POST" action="/customer/otp">
          <input type="hidden" name="phone" value="<%= phone %>">
          <div class="form-floating">
            <input type="text" class="form-control form-control-otp" id="otp" name="otp" placeholder="0000" required pattern="[0-9]{<%= otp_length %>}" maxlength="<%= otp_length %>" autofocus>
            <label for="otp">
              <i class="bi bi-shield-lock me-2"></i>Kode OTP (<%= otp_length %> digit)
            </label>
          </div>
          <button type="submit" class="btn btn-primary btn-login w-100">
            <i class="bi bi-check-circle me-2"></i>Verifikasi
          </button>
        </form>
        <div class="text-center footer-text">
          &copy; <%= new Date().getFullYear() %> <%= settings.company_header || 'Billing Nusa Digital' %>
        </div>
      </div>
    </div>
  </div>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      });
    }
  </script>
</body>

</html>
